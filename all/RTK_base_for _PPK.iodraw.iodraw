            <mxPoint x="310" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-69" value="&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Message&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;UBX class / ID&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;What it provides&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Base&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Rover&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;RXM-RAWX&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;0x02 / 0x15&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Pseudorange, carrier phase, Doppler, C/N₀, measurement time&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Required&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Required&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;RXM-SFRBX&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;0x02 / 0x13&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Satellite navigation subframes containing ephemeris-related data&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Recommended&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Recommended&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="60" y="860" width="710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-70" value="&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;RXM-RAWX&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;is converted to .obs (Observation file) RINEX file&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;&amp;nbsp; &amp;nbsp;RXM-SFRBX&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;is converted to .nav (Navigation file) RINEX file&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="160" y="980" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-72" value="With RINEX v2.x.x version, you can also get other nav files likes .gnav, hnav, qnav, inav, etc." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="528" y="690" width="221" height="70" as="geometry" />
        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-73" value=".sbs" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="660" y="660" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-74" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.677;exitY=1.005;exitDx=0;exitDy=0;exitPerimeter=0;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="PSIyUP0I5wQG2Wr1szq5-60" target="PSIyUP0I5wQG2Wr1szq5-73" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="340" y="830" as="sourcePoint" />
            <mxPoint x="390" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-0" value="In RTKPOST&lt;div&gt;&lt;br&gt;&lt;div&gt;The Base position inside Position tab inside options can take different values like:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;1. &lt;b&gt;Lat/Log/Alt --&amp;gt;&lt;/b&gt; Here you can put the values of latitude, longitude, and altitude hard into the respective fields. Which should give the more accurate result, and precise value of coordinates of rover.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. &lt;b&gt;From RINEX Header --&amp;gt;&lt;/b&gt; Here you might get different and shifted values. As in our case I saw all the coordinates shifted by a fixed value. This could be due to inaccurate coordinate of base station obtained from RINEX Header.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;3. &lt;b&gt;From Base Station Position file --&amp;gt;&lt;/b&gt; I checked this and uploaded Base&#39;s .pos file at appropriate place, but execution is not working, there is some error with reading the pos file i guess.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Below are the shifts I encountered when Base position is obtained from RINEX Header, compared to when hard values are provided to the coordinates of Base station.&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;dashed=1;align=left;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="60" y="3552" width="703" height="230" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="117.6" y="3792" width="567.8" height="360" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="117.6" y="4172" width="598.86" height="460" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-4" value="&lt;b&gt;RTKCONV&lt;/b&gt; AP is a GUI based tool to convert different GNSS formats into RINEX of different versions. If using ublox F9P, we have .ubx file which has to converted to RINEX &lt;b&gt;obs&lt;/b&gt; and &lt;b&gt;nav&lt;/b&gt; files. The &lt;b&gt;RTKPOST&lt;/b&gt; AP then takes &lt;b&gt;obs&lt;/b&gt; and &lt;b&gt;nav&lt;/b&gt; files to do Post Processing Kinematics (&lt;b&gt;PPK&lt;/b&gt;)." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="60" y="750" width="430" height="90" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="53.5" y="1320" width="227.34" height="240" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-6" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="300.14" y="1320" width="225.72" height="240" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-7" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="542.11" y="1320" width="227.89" height="240" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-8" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="190" y="1580" width="225.69" height="240" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-9" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="433" y="1580" width="228.39" height="240" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-10" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="84.56" y="1980" width="515.87" height="300" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-12" value="&lt;span style=&quot;white-space: nowrap;&quot;&gt;Now, after we have conversion done and we have obs and nav files (observation and Navigation files), we can use RTKPOST to process&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;the data recorded.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;white-space: nowrap; background-color: initial;&quot;&gt;Before proceeding upload data into RTKPOST, open the Options and set it on every required tabs.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div style=&quot;white-space: nowrap;&quot;&gt;&lt;div style=&quot;&quot;&gt;We can also use already tested config file for settings which can simply be Loaded using Load. We can use f9p_ppk.conf file which comes&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;with the&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;RTK APs (all RTKLIB version 2.4.3 onwards has it) in the same directory. Note that this config file make position of the base station&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;to RINEX Header. We can&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;have hard put coordinate values for coordinates of Base station though whihc is more accurate.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;dashed=1;align=left;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="49" y="1210" width="750" height="105" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-13" value="In RTKPOST app, you need to upload Rover-obs file, Base-obs file and then nav file belonging to either Base or Rover (Rover&#39;s nav file&amp;nbsp;&lt;div&gt;is generally used). You can also have .sbs file (but not tested), and RTCM (also not tested). You can select the output (solution)&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;directory&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;at bottom. Then we can execute the program, and after the execution is done we can see the plots, or view the file.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Note that in the file you can see Q value column, which has integer values starting 1. 1 means RTK fixed is obtained, 2 means float.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;And higher value like 5 means single mode, so no RTK or DGNSS at all.&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="53.5" y="1860" width="750" height="100" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-14" value="&lt;b&gt;ROVER .obs file&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="635.43" y="2040" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uZqQzihwqD7uEiuLLD7T-15" value="&lt;b&gt;ROVER .nav file&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
