        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-72" value="With RINEX v2.x.x version, you can also get other nav files likes .gnav, hnav, qnav, inav, etc." style="rounded=0;whiteSpace=wrap;html=1;strokeColor=default;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
