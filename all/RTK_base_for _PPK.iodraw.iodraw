          <mxGeometry x="269" y="7050" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-45" value="&lt;h3&gt;&lt;strong&gt;&amp;nbsp;Configure the trigger parameters&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Parameter&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Example value&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Purpose&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_MODE&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;4&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Distance-based survey mode&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_INTERFACE&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;GPIO interface&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_POLARITY&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Active high&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_ACT_TIME&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;40&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Trigger pulse width in ms&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_DISTANCE&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;10&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Distance between images in metres&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_INTERVAL&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1000&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Interval in ms for time-based modes&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;TRIG_MIN_INTERVA&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;500&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Minimum time between photographs in ms&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="70.32" y="8330" width="450" height="400" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-46" value="&lt;h3&gt;&lt;strong&gt;Configure camera capture feedback&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Parameter&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Value&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Purpose&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CAM_CAP_FBACK&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Enable capture feedback&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CAM_CAP_EDGE&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Capture rising edge&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CAM_CAP_MODE&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;0&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Timestamp the capture edge&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CAM_CAP_REPORT&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Enable MAVLink capture reporting&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="84.19999999999999" y="8760" width="340" height="270" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-47" value="&lt;h2&gt;&lt;strong&gt;How to test camera trigger and capture&lt;/strong&gt;&lt;/h2&gt;&lt;p&gt;Open the MAVLink Console in QGroundControl.&lt;/p&gt;&lt;p&gt;Check the driver status:&lt;/p&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;camera_trigger status&lt;br&gt;camera_capture status&lt;br&gt;camera_feedback status&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Generate a test trigger pulse:&lt;/p&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;camera_trigger test&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Note that this particular test command is intended for testing the physical output and does not generate the normal logged trigger event.&lt;/p&gt;&lt;p&gt;Monitor the uORB messages:&lt;/p&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;listener camera_trigger 5&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;div&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;listener camera_capture 5&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="58.49999999999999" y="8990" width="740" height="330" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-48" value="&lt;b&gt;EMLID Studio app&lt;/b&gt; which is free to use tool can be used for post processing of data for PPK solution. But I&amp;nbsp;&lt;div&gt;have noticed that the processing result given by EMLID studio 1.11 is very different and seems inaccurate&lt;/div&gt;&lt;div&gt;or having limited processing capability, resulting in more float points(Q=2), where as RTKLIB gives almost&amp;nbsp;&lt;/div&gt;&lt;div&gt;no float points with the same RINEX data. Note that the conversion to RINEX was done in RTKLIB only&amp;nbsp;&lt;/div&gt;&lt;div&gt;creating same RINEX files for tests with both tools.&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="59" y="11095" width="690" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_7VIP9LqbnxQb51wslxi-0" value="For PX4 version 1.18.xx, we have&amp;nbsp;&lt;div&gt;another parameter called GPS_UBX_PPK which can be enabled along with GPS_DUMP_COMM, but I did not&lt;/div&gt;&lt;div&gt;find any difference kepping it disabled. Having it enbaled or disabled gave the same result.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="549" y="4920" width="237.89" height="150" as="geometry" />
        </mxCell>
        <mxCell id="_7VIP9LqbnxQb51wslxi-2" value="When you enable the TRIG_MODE parameter, then the other parameters related to Trigger appears" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="510.32" y="8470" width="167.89" height="140" as="geometry" />
        </mxCell>
        <mxCell id="_7VIP9LqbnxQb51wslxi-3" value="When you enable the CAM_CAP_FBACK&amp;nbsp; parameter, then the other parameters related to camera capture will appears" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="455.25" y="8860" width="185.07" height="150" as="geometry" />
        </mxCell>
        <mxCell id="1ez_Ij9bfWL4bWsxR2hU-0" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="193.63" y="12320" width="452.76" height="390" as="geometry" />
        </mxCell>
        <mxCell id="1ez_Ij9bfWL4bWsxR2hU-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="176.61" y="11880" width="474.78" height="390" as="geometry" />
        </mxCell>
        <mxCell id="1ez_Ij9bfWL4bWsxR2hU-2" value="Image1: PPK result from EMLID studio 1.11" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="283.5" y="12275" width="260" height="30" as="geometry" />
