        <mxCell id="1ez_Ij9bfWL4bWsxR2hU-8" value="We can build similar tool as EMLID Studio for Post processing. The EMLID Studio by BTW has almost all tools required for basic PPK kinematics or Static, or single mode processing. It also has Convertor tool. We can design our own very similar tool implementing most recent version of RTKLIB producing better results." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="75.45000000000002" y="12760" width="703.55" height="60" as="geometry" />
        </mxCell>
        <mxCell id="1ez_Ij9bfWL4bWsxR2hU-9" value="&lt;div class=&quot;n6owBd awi2gc&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-hveid=&quot;CAIIAAgBCA8QAA&quot; data-complete=&quot;true&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 0px 0px 16px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div class=&quot;yhAwj&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; data-sfc-inited=&quot;2&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;/div&gt;&lt;div data-bfc=&quot;&quot; class=&quot;&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qi4wTegoIAggACAEIGhAA&quot; data-hveid=&quot;CAIIAAgBCBoQAA&quot; data-complete=&quot;true&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;div class=&quot;SoTdyb DkUrn MsGyee A8DX3e DeI1Vb KDGs1d tK5fob KqGeOc Ix9IW rAdPSe&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Q-q4QegoIAggACAEIGhAB&quot; data-hveid=&quot;CAIIAAgBCBoQAQ&quot; data-complete=&quot;true&quot; data-sfc-inited=&quot;2&quot; style=&quot;margin: 4px 0px 12px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;table class=&quot;nOQsj&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;tbody style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAC&quot; data-complete=&quot;true&quot;&gt;&lt;th class=&quot;BSFG4e&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;Q Value&lt;/th&gt;&lt;th class=&quot;BSFG4e&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&amp;nbsp;Status Name&lt;/th&gt;&lt;th class=&quot;BSFG4e&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;Typical Default Color&lt;/th&gt;&lt;th class=&quot;BSFG4e&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;Meaning &amp;amp; Typical Accuracy&lt;/th&gt;&lt;/tr&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAE&quot; data-complete=&quot;true&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;0&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;None / Invalid&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;None (not plotted)&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;No valid position solution could be calculated.&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAF&quot; data-complete=&quot;true&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;1&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;Fix&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Green&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Highest precision (1–3 cm).&lt;/span&gt; Carrier-phase integer &lt;br&gt;ambiguities are fullyresolved. This is the target &lt;br&gt;goal for PPK surveying.&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAG&quot; data-complete=&quot;true&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;2&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;Float&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Yellow / Orange&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Sub-meter precision (10 cm – 1 m).&lt;/span&gt; Carrier-phase &lt;br&gt;relative positioning is used, but integer ambiguities &lt;br&gt;are not yet locked.&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAH&quot; data-complete=&quot;true&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;3&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;SBAS / Reserved&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Cyan / Light Blue&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;Reserved in standard RTKLIB; occasionally used &lt;br&gt;for SBAS-aided solutions depending on the &lt;br&gt;software fork.&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAI&quot; data-complete=&quot;true&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;4&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;DGPS&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Blue / Magenta&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0.909091px solid rgb(210, 210, 210);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Meter-level precision (0.5–2 m).&lt;/span&gt; Code-based &lt;br&gt;differential GNSS or single-pointpositioning &lt;br&gt;with SBAS corrections.&lt;/td&gt;&lt;/tr&gt;&lt;tr class=&quot;l2uqvb&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; data-visible=&quot;1&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-ved=&quot;2ahUKEwiSssnU1aeYAxXlRmwGHZ2KI30Qw4oVegoIAggACAEIGhAJ&quot; data-complete=&quot;true&quot;&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;5&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;&amp;nbsp;Single&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Red&lt;/span&gt;&lt;/td&gt;&lt;td class=&quot;Vk1lqb&quot; style=&quot;font-size: 14px; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot; colspan=&quot;undefined&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Lowest precision (2–5+ m).&lt;/span&gt; Standard standalone &lt;br&gt;GNSS positioning with no differential base station &lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;corrections applied.&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
          <mxGeometry x="92.99999999999997" y="10670" width="670" height="380" as="geometry" />
        </mxCell>
        <mxCell id="1ez_Ij9bfWL4bWsxR2hU-10" value="&lt;span data-subtree=&quot;aimfl,mfl&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;In GNSS/PPK processing software—most notably &lt;b&gt;RTKLIB&lt;/b&gt;,&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap; font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Emlid Studio&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap;&quot;&gt;, and similar engines—the&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap; font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;Quality Flag (Q)&amp;nbsp;&lt;/span&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;background-color: initial; white-space: nowrap; font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;ranges from 1 to 5&lt;/span&gt;&lt;span style=&quot;background-color: initial; white-space: nowrap; font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px;&quot;&gt; (with &lt;/span&gt;&lt;span class=&quot;rQesXe MPyX&quot; data-sfc-cp=&quot;&quot; data-sfc-root=&quot;c&quot; data-complete=&quot;true&quot; style=&quot;background-color: initial; white-space: nowrap; font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-weight: 700; margin: 0px; border-bottom: 0px rgb(10, 10, 10);&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;background-color: initial; white-space: nowrap; font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px;&quot;&gt; representing no solution), indicating how&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial; font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap;&quot;&gt;the&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial; font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap;&quot;&gt;satellite positioning data&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap; background-color: initial;&quot;&gt;was resolved and its resulting accuracy.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap; background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; text-align: center; white-space: nowrap;&quot;&gt;This is the standard scale seen in most PPK post-processing plots (such as RTKPLOT):&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; white-space: nowrap; background-color: initial;&quot;&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
