        <mxCell id="PSIyUP0I5wQG2Wr1szq5-69" value="&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Message&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;UBX class / ID&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;What it provides&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Base&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Rover&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;RXM-RAWX&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;0x02 / 0x15&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Pseudorange, carrier phase, Doppler, C/N₀, measurement time&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Required&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Required&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;RXM-SFRBX&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;0x02 / 0x13&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Satellite navigation subframes containing ephemeris-related data&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Recommended&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Recommended&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="58" y="770" width="710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="PSIyUP0I5wQG2Wr1szq5-70" value="&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;RXM-RAWX&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;is converted to .obs (Observation file) RINEX file&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;strong&gt;&amp;nbsp; &amp;nbsp;RXM-SFRBX&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/strong&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;font face=&quot;monospace&quot;&gt;is converted to .nav (Navigation file) RINEX file&lt;/font&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
