        <mxCell id="skBJgnmRKNtt9fFM8vUw-1" value="&lt;h2&gt;&lt;br&gt;&lt;/h2&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="70.32" y="5195" width="20" height="60" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-2" value="&lt;h2 style=&quot;white-space: nowrap;&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Configure your F9P base to generate RTCM3&lt;/font&gt;&lt;/h2&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;Connect your F9P base to u-center 2 through USB.&lt;/p&gt;&lt;h3 style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Step 1 — Configure base station mode&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;In &lt;strong&gt;Device Configuration&lt;/strong&gt;, configure:&lt;/p&gt;&lt;div style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Configuration key&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Value&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-TMODE-MODE&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;1&lt;/code&gt; (Survey-in)&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-TMODE-SVIN_MIN_DUR&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;300&lt;/code&gt; seconds&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-TMODE-SVIN_ACC_LIMIT&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;20000&lt;/code&gt; (2 m in 0.1 mm units)&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;These values are suitable for an initial test. Alternatively, use Fixed mode with accurately known base antenna coordinates.&lt;/p&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;The base must complete survey-in or have valid fixed coordinates before normal reference-station operation.&lt;/p&gt;&lt;div style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;div&gt;&lt;/div&gt;device.report&lt;/div&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;/p&gt;&lt;h3 style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;strong&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Step 2 — Enable RTCM3 output on USB&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;Set these configuration keys in u-center 2:&lt;/p&gt;&lt;div style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;table&gt;&lt;tbody&gt;&lt;tr&gt;&lt;th&gt;&lt;p&gt;Configuration key&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Value&lt;/p&gt;&lt;/th&gt;&lt;th&gt;&lt;p&gt;Output rate at 1 Hz&lt;/p&gt;&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-MSGOUT-RTCM_3X_TYPE1005_USB&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;5&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Every 5 seconds&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-MSGOUT-RTCM_3X_TYPE1074_USB&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Every second&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-MSGOUT-RTCM_3X_TYPE1084_USB&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Every second&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-MSGOUT-RTCM_3X_TYPE1094_USB&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Every second&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-MSGOUT-RTCM_3X_TYPE1124_USB&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;1&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Every second&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;code&gt;CFG-MSGOUT-RTCM_3X_TYPE1230_USB&lt;/code&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;10&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;Every 10 seconds&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;Enable only the observation message types for the GNSS constellations in use. These values refer to message intervals in&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;navigation&amp;nbsp;&lt;span style=&quot;white-space: normal&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;solutions, so the example assumes a 1 Hz rate.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;Also ensure:&lt;/p&gt;&lt;p style=&quot;text-align: left; white-space: nowrap;&quot;&gt;&lt;code&gt;CFG-USBOUTPROT-RTCM3X = 1&lt;/code&gt;&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="63" y="13050" width="700" height="900" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-6" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;PX4 Autopilot up to version 1.17.0&lt;/font&gt;&lt;div style=&quot;font-size: 14px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; font-size: 14px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;GPS_DUMP_COMM &lt;/b&gt;--&amp;gt; 2 (record RTCM data)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left; font-size: 14px;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;SDLOG_MODE&lt;/b&gt; --&amp;gt; 2 (record from boot until shutdown)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 14px; white-space: nowrap;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;(can be set in case you are bench testing)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="67.32000000000001" y="4780" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-11" value="" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="WIyWlLk6GJQsqaUBKTNV-1" source="skBJgnmRKNtt9fFM8vUw-6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="199.32" y="4580" as="sourcePoint" />
            <mxPoint x="251.89" y="4960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-16" value="&lt;span style=&quot;font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;This config will start logging GPS dump&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;along with the general&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 11px; background-color: rgb(255, 255, 255);&quot;&gt;flight log (.ulg) found&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px;&quot;&gt;under log directory inside the SD card,&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px;&quot;&gt;which can be downloaded with QGC at&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 11px;&quot;&gt;QGC Analysis-&amp;gt;Onboard Logs.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="447.89" y="4790" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-17" value=".ulg flight log" style="rhombus;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="209.32" y="4960" width="86" height="90" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-18" value="&lt;b&gt;Extraction of RTCM or UBX from PX4 flight log&lt;/b&gt;&lt;div&gt;&lt;b style=&quot;color: rgb(0, 76, 153); background-color: initial;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;color: rgb(0, 76, 153); background-color: initial;&quot;&gt;pip install --upgrade pyulog&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;pre style=&quot;&quot; dir=&quot;ltr&quot;&gt;&lt;code&gt;&lt;font color=&quot;#004c99&quot;&gt;&lt;b&gt;ulog_extract_gps_dump flight.ulg&lt;/b&gt;&lt;/font&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
          <mxGeometry x="107.25" y="5085" width="290.13" height="100" as="geometry" />
        </mxCell>
        <mxCell id="skBJgnmRKNtt9fFM8vUw-19" value="&lt;p style=&quot;text-align: left;&quot;&gt;It generates two files:&lt;/p&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;pre dir=&quot;ltr&quot;&gt;&lt;code&gt;flight_0_from_device.dat&lt;br&gt;flight_0_to_device.dat&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 13px; white-space: nowrap;&quot;&gt;We need&amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;b&gt;flight_0_from_device.dat&lt;br&gt;&lt;/b&gt;&lt;span style=&quot;font-family: Helvetica; white-space: nowrap;&quot;&gt;file for further use&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
