        <mxCell id="5vReZsCvzMeAvtyp_lui-54" value="&lt;u style=&quot;font-size: 12px;&quot;&gt;Configuration&lt;/u&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;u style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/u&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;1. CFG-UART1-BAUDRATE -&amp;gt; 57600&lt;/div&gt;&lt;/div&gt;" style="edgeLabel;resizable=0;html=1;;align=left;verticalAlign=bottom;rotation=0;fontSize=12;labelBorderColor=#999999;" parent="1" connectable="0" vertex="1">
