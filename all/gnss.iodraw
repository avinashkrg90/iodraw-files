        <mxCell id="5vReZsCvzMeAvtyp_lui-53" value="&lt;u style=&quot;font-size: 12px;&quot;&gt;Configuration&lt;/u&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;u style=&quot;font-size: 12px;&quot;&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/u&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;1. CFG-UART1-BAUDRATE -&amp;gt; 57600&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;2. CFG-TMODE : MODE-&amp;gt;1(Survey-in)&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;white-space: pre; font-size: 12px;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre; font-size: 12px;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre; font-size: 12px;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; SVIN_MIN_DURATION-&amp;gt;60sec&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;&lt;span style=&quot;white-space: pre; font-size: 12px;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre; font-size: 12px;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre; font-size: 12px;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; SVIN_ACC_LIMIT -&amp;gt; 2000mm&lt;/div&gt;&lt;div style=&quot;font-size: 12px;&quot;&gt;3. CFG-MSGOUT: All RTCM-3x-...belonging to UART1 to 1&lt;/div&gt;&lt;/div&gt;" style="edgeLabel;resizable=0;html=1;;align=left;verticalAlign=bottom;rotation=0;fontSize=12;labelBorderColor=#999999;" parent="1" connectable="0" vertex="1">
