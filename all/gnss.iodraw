        <mxCell id="5vReZsCvzMeAvtyp_lui-56" value="Acting as RTK Rover here" style="edgeLabel;resizable=0;html=1;;align=left;verticalAlign=bottom;rotation=0;fontSize=13;" parent="1" connectable="0" vertex="1">
